# Скрипты подключают общую библиотеку своего каталога (checks/lib.sh,
# provision/lib.sh). Без этих двух настроек shellcheck её не находит и сыплет
# SC1091 на каждом `.`-подключении, а заодно ложными SC2034 на переменных,
# которые объявлены в библиотеке, а используются в вызывающем скрипте.
#
# SCRIPTDIR — искать подключаемое рядом со скриптом, а не относительно
# текущего каталога: проверки запускают и из корня репозитория, и из checks/.
external-sources=true
source-path=SCRIPTDIR
