# Скопировать в .env и заполнить. .env в git не попадает.

# ---------------------------------------------------------------------------
# Теги образов — НЕОБЯЗАТЕЛЬНО
# ---------------------------------------------------------------------------
# Проверенные версии зашиты в docker-compose.yml. Раскомментируйте строку,
# только если нужна другая — например при обновлении.
#
# Никогда latest: миграции БД у *arr односторонние, откат после запуска новой
# версии невозможен. И перед сменой версии — снапшот.
#
# QBITTORRENT_TAG=
# PROWLARR_TAG=
# RADARR_TAG=
# SONARR_TAG=
# LAMPAC_TAG=

# ---------------------------------------------------------------------------
# Пути
# ---------------------------------------------------------------------------
# DATA_ROOT — ЕДИНСТВЕННОЕ монтирование, оно становится /data во всех
# контейнерах. Пути ниже задаются ОТНОСИТЕЛЬНО него и обязаны оставаться
# внутри: раздельные bind-монтирования ломают жёсткие ссылки даже когда обе
# точки лежат на одной файловой системе.
#
# Проверено опытом: два bind-монтирования одного каталога дали одинаковый
# номер устройства (stat -c %d), а ln между ними вернул EXDEV. Отсюда же
# следствие: сравнения номеров устройств НЕДОСТАТОЧНО, нужна проба ссылкой.
# Она есть в scripts/init-data.sh и в checks/02-data-layout.sh.
DATA_ROOT=/srv/data

# Промежуточное хранение: сюда качает qBittorrent. Внутри создаются
# подкаталоги movies/ и tv/ по категориям.
TORRENTS_PATH=torrents

# Библиотека. Можно указать на уже существующие каталоги — например
# MOVIES_PATH=Movies и TV_PATH=TV shows, если библиотека уже так разложена.
MOVIES_PATH=media/movies
TV_PATH=media/tv

# Куда класть конфигурацию сервисов. Относительный путь считается от
# docker-compose.yml; для Ansible удобнее абсолютный, например
# /opt/media-stack/config.
CONFIG_ROOT=./config


# ---------------------------------------------------------------------------
# Хост
# ---------------------------------------------------------------------------

# id -u и id -g того пользователя, которому принадлежит DATA_ROOT
PUID=1000
PGID=1000

# 002 даёт группе право записи. Нужно, чтобы qBittorrent и *arr
# работали с файлами друг друга. Переменная UMASK, не UMASK_SET —
# последняя признана устаревшей.
UMASK=002

TZ=Europe/Moscow

# ---------------------------------------------------------------------------
# API-ключи
# ---------------------------------------------------------------------------
# Забираются из веб-морд после первого запуска:
# Settings -> General -> Security -> API Key
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=

# qBittorrent: логин задаётся при первом входе.
# Временный пароль пишется в лог: docker compose logs qbittorrent
QBITTORRENT_USER=admin
QBITTORRENT_PASSWORD=

# ---------------------------------------------------------------------------
# bridge
# ---------------------------------------------------------------------------
# dev  — поиск НИКОГДА не запускается, plugin.js отдаётся с no-store
# prod — поиск запускается
BRIDGE_ENV=dev

RADARR_PROFILE=HD-1080p

# Допустимые значения: announced | inCinemas | released | preDB
# released — рекомендуемое по умолчанию.
# preDB сейчас ведёт себя идентично released (predb.me блокирует Radarr),
# использовать его смысла нет.
# ВАЖНО: слишком строгое значение приводит к тому, что фильм добавлен,
# но поиск не стартует. Ошибки при этом нет.
RADARR_MIN_AVAILABILITY=released

SONARR_PROFILE=HD-1080p

# Bearer-токен TMDB v4 (Read Access Token), не v3 api_key
TMDB_TOKEN=

# Тег, которым помечаются тестовые заказы — чтобы потом отличить и снести
# CORS. Обычно пусто: действует правило «тот же хост, любой порт».
# Заполнять только для нестандартной установки. Никогда "*".
CORS_ORIGINS=

# Тег на заказах, сделанных в dev-режиме. Нужен, чтобы отличить их потом и
# снести одной командой, не разбирая библиотеку вручную.
# ---------------------------------------------------------------------------
# Схема имён — НЕОБЯЗАТЕЛЬНО
# ---------------------------------------------------------------------------
# Проверенные строки TRaSH Guides зашиты в образ. Заполнять, только если нужна
# своя схема. Обоснование и происхождение строк — docs/NAMING.md.
#
# Менять ДО того, как библиотека наполнится: иначе придётся переименовывать
# всё разом.
#
# RADARR_MOVIE_FORMAT=
# RADARR_FOLDER_FORMAT=
# SONARR_EPISODE_FORMAT=
# SONARR_DAILY_FORMAT=
# SONARR_ANIME_FORMAT=
# SONARR_SERIES_FOLDER_FORMAT=
# SONARR_SEASON_FOLDER_FORMAT=

TEST_TAG=test

# ---------------------------------------------------------------------------
# Версия набора
# ---------------------------------------------------------------------------
# Версия ОБРАЗОВ bridge и media-stack — тех, что собираются из этого
# репозитория. Версии *arr и qBittorrent живут отдельно, они зашиты в
# docker-compose.yml.
#
# Без этой строки compose берёт latest, и две установки, сделанные в разные
# дни, оказываются разными. Раздача двумя файлами затевалась ради обратного,
# поэтому версия закрепляется здесь явно.
STACK_VERSION=1.1.0
